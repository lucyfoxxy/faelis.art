# Listener / storage
GUESTBOOK_HOST=127.0.0.1
GUESTBOOK_PORT=8787
GUESTBOOK_DB=/srv/faelis.art/data/guestbook.sqlite
GUESTBOOK_PUBLIC_ORIGIN=https://faelis.art

# Required secret for one-way IP hashes used by rate limiting.
# Generate e.g. with: openssl rand -hex 32
GUESTBOOK_IP_SECRET=change-me

# Moderation mail
GUESTBOOK_MAIL_MODE=smtp
GUESTBOOK_MODERATION_TO=guestbook@faelis.art
GUESTBOOK_MAIL_FROM=Faelis Guestbook <guestbook@faelis.art>
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Abuse limits
GUESTBOOK_RATE_LIMIT=5
GUESTBOOK_RATE_WINDOW_SECONDS=3600
GUESTBOOK_MIN_FILL_MS=1500
